# VPS Server Port Configuration
PORT=1000
HOST=0.0.0.0
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://your-vps-ip:1000 or https://yourdomain.com)
APP_URL="http://localhost:1000"
